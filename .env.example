# ─────────────────────────────────────────────────────────────────────────────
# T/R Agency — Environment Variables
# Copy this file to .env for local development.
# Set these variables in your hosting dashboard (Render / Vercel) for production.
# Never commit real values to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER (Render) ───────────────────────────────────────────────────────────

# Render sets PORT automatically — you do NOT need to set this manually on Render.
# PORT=3001

NODE_ENV=production

# Path where JSON data files (accounts, projects, messages) are stored.
# ⚠️  CRITICAL FOR RENDER: Render's default filesystem is EPHEMERAL — all data
# in /opt/render/project/src/ is wiped on every redeploy. To survive redeploys:
# 1. Add a Render Persistent Disk (Render dashboard → your service → Disks)
#    Mount path: /data   |   Size: 1GB (free tier starts at $0.25/GB/mo)
# 2. Set DATA_DIR=/data here
# Without this, every redeploy erases all accounts, projects, and messages.
DATA_DIR=

# Full URL of this backend service (no trailing slash).
# Used to build OAuth callback URLs.
# Example: https://tr-agency.onrender.com
APP_URL=

# Full URL of the frontend (Vercel).
# Used for CORS and OAuth post-login redirects.
# Example: https://tr-agency.vercel.app
FRONTEND_URL=

# Secret for signing express-session cookies (OAuth state handshake).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# "From" address for all outgoing emails.
# Must be a verified sender domain in your Resend account.
# Example: T/R Agency <noreply@yourdomain.com>
FROM_EMAIL=

# Admin panel password
ADMIN_PASSWORD=

# Discord webhook URL for lead/cancellation notifications (optional)
VITE_DISCORD_WEBHOOK_URL=

# ── Whop checkout (server only) ───────────────────────────────────────────────
# Create an account API key in Whop Developer → API keys. Never expose it as VITE_.
WHOP_API_KEY=
# Your Whop business/account ID, prefixed biz_.
WHOP_COMPANY_ID=
# Endpoint signing secret for the payment webhook.
WHOP_WEBHOOK_SECRET=
# Optional API base override for test/sandbox environments.
WHOP_API_BASE_URL=
# JSON object keyed by the service IDs in src/services.js.
# Example: {"launch-validation":"plan_xxx","qa-insights":"plan_yyy","launch-assurance":"plan_zzz"}
WHOP_PLAN_IDS=
# Configure this exact endpoint in Whop Developer → Webhooks:
# https://your-backend.example.com/api/webhooks/whop

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://your-render-app.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-render-app.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── FRONTEND (Vercel) ─────────────────────────────────────────────────────────
# All VITE_ vars are bundled into the frontend at build time.

# Full URL of your Render backend (no trailing slash).
# Leave empty when frontend and backend are served from the same origin.
# Example: https://tr-agency.onrender.com
VITE_API_URL=

# Discord webhook for client-side lead backup (optional — same value as above)
VITE_DISCORD_WEBHOOK_URL=
