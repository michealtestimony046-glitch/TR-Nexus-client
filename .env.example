# ─────────────────────────────────────────────────────────────────────────────
# T/R Agency — Environment Variables
# Copy this file to .env for local development.
# Set these variables in your hosting dashboard (Render / Vercel) for production.
# Never commit real values to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER (Render) ───────────────────────────────────────────────────────────

# Render sets PORT automatically — you do NOT need to set this manually on Render.
# PORT=3001

NODE_ENV=production

# Full URL of this backend service (no trailing slash).
# Used to build OAuth callback URLs.
# Example: https://tr-agency.onrender.com
APP_URL=

# Full URL of the frontend (Vercel).
# Used for CORS and OAuth post-login redirects.
# Example: https://tr-agency.vercel.app
FRONTEND_URL=

# Secret for signing express-session cookies (OAuth state handshake).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# "From" address for all outgoing emails.
# Must be a verified sender domain in your Resend account.
# Example: T/R Agency <noreply@yourdomain.com>
FROM_EMAIL=

# Admin panel password
ADMIN_PASSWORD=

# Discord webhook URL for lead/cancellation notifications (optional)
VITE_DISCORD_WEBHOOK_URL=

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://your-render-app.onrender.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-render-app.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── FRONTEND (Vercel) ─────────────────────────────────────────────────────────
# All VITE_ vars are bundled into the frontend at build time.

# Full URL of your Render backend (no trailing slash).
# Leave empty when frontend and backend are served from the same origin.
# Example: https://tr-agency.onrender.com
VITE_API_URL=

# Discord webhook for client-side lead backup (optional — same value as above)
# VITE_DISCORD_WEBHOOK_URL=
